APIFY_TOKEN=         # Apify API token — never commit the real value
APIFY_MAX_RUNS_PER_AUDIT=48
COMPETITOR_MIN_LOCAL_FOLLOWERS=150
COMPETITOR_MIN_REFERENCE_FOLLOWERS=400
COMPETITOR_MIN_POST_COUNT=3
ANTHROPIC_API_KEY=   # Legacy report sections only — NOT used by the intelligence pipeline
# ── OpenRouter (Instagram Intelligence pipeline) ──
OPENROUTER_API_KEY=                                   # required for live LLM enrichment; pipeline runs deterministically without it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FAST=openai/gpt-5.4-nano
OPENROUTER_MODEL_SMART=openai/gpt-5.4-mini
OPENROUTER_APP_NAME=BotLogix Instagram Intelligence
OPENROUTER_SITE_URL=https://botlogix.ca
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_RETRIES=2
DATABASE_URL=postgres://botlogix:botlogix@127.0.0.1:55432/botlogix
POSTGRES_PORT=55432
POSTGRES_DB=botlogix
POSTGRES_USER=botlogix
POSTGRES_PASSWORD=botlogix
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PORT=5057
PUBLIC_BASE_URL=http://localhost:5057
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BotLogix <reports@botlogix.ca>
