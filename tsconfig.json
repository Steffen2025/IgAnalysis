{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src/admin/**/*.ts",
    "src/db/**/*.ts",
    "src/services/**/*.ts",
    "src/scripts/generateBotLogixDeck.ts"
  ],
  "exclude": [
    "node_modules",
    "reports",
    "drizzle",
    "drizzle-pg",
    "src/services/marp-report/slideBuilders/battlePlanSlide.ts",
    "src/services/marp-report/slideBuilders/patternsSlide.ts",
    "src/services/marp-report/slideBuilders/scoreBreakdownSlide.ts"
  ]
}
